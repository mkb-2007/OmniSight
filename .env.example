# ==============================================================================
# OmniSight Environment Configuration
# ==============================================================================

# Server port for the Express backend API
PORT=3001

# Database persistence file path (JSON-based file store)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secret Key (change in production!)
AUTH_SECRET="your_secure_jwt_secret_key_here"

# JWT Token Expiration Duration
JWT_EXPIRES_IN="7d"

# Node Environment: "development" or "production"
NODE_ENV="development"
